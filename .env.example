# openrouteservice — free key, REQUIRED for real driving routes
# https://openrouteservice.org → sign up → Dashboard → request token
NEXT_PUBLIC_ORS_API_KEY=

# MapTiler — optional free key for the native dark basemap.
# Without it the app uses keyless OpenStreetMap tiles (never requires a key).
# https://cloud.maptiler.com → free plan
NEXT_PUBLIC_MAP_TILER_KEY=

# Supabase (optional) — realtime + database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=